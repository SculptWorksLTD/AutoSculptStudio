{
  "id": "sf3d",
  "name": "Stable Fast 3D",
  "version": "1.0.2",
  "install_version": "1.0.0",
  "description": "A second engine on this computer: a 3D shape from one photo in about a minute, free and offline after the installation. Softer and less detailed than the main local engine, useful to compare. Powered by Stability AI.",
  "license": "Stability AI Community License: free also for commercial use below 1 million USD of yearly revenue (registration with Stability AI required)",
  "homepage": "https://huggingface.co/stabilityai/stable-fast-3d",
  "download_gb": 4.3,
  "minutes": "about 1 minute per photo on the processor, a few seconds on NVIDIA cards",
  "hf_gated": {
    "model_url": "https://huggingface.co/stabilityai/stable-fast-3d",
    "token_url": "https://huggingface.co/settings/tokens",
    "register_url": "https://stability.ai/community-license"
  },
  "steps": [
    {
      "label": "PyTorch (computing engine)",
      "pkgs": [
        "torch",
        "torchvision"
      ],
      "win_nvidia": [
        "--index-url",
        "https://download.pytorch.org/whl/cu124",
        "--extra-index-url",
        "https://pypi.org/simple"
      ]
    },
    {
      "label": "geometry libraries",
      "pkgs": [
        "einops",
        "omegaconf",
        "jaxtyping",
        "trimesh",
        "scipy",
        "Pillow",
        "safetensors",
        "huggingface-hub<1.0"
      ]
    },
    {
      "label": "vision model",
      "alternatives": [
        [
          "transformers>=4.40,<4.48"
        ],
        [
          "transformers>=4.40,<4.50"
        ]
      ]
    },
    {
      "label": "background removal",
      "alternatives": [
        [
          "rembg[cpu]"
        ],
        [
          "rembg"
        ]
      ]
    }
  ],
  "source": {
    "url": "https://github.com/Stability-AI/stable-fast-3d/archive/ff21fc491b4dc5314bf6734c7c0dabd86b5f5bb2.zip"
  },
  "weights": {
    "hf_repo": "stabilityai/stable-fast-3d",
    "files": [
      "config.yaml",
      "model.safetensors"
    ]
  },
  "runner": "runner.py",
  "options": [
    {
      "id": "remove_bg",
      "label": "Remove the photo background",
      "type": "bool",
      "default": true
    }
  ],
  "order": 85
}
